<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ app_title }}</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body {
            background-color: #0f0f10;
            color: #f3f4f6;
            font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        }
        .code-font {
            font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
        }
    </style>
</head>
<body class="min-h-screen flex items-center justify-center p-6">
    <div class="max-w-2xl w-full bg-[#18181b] border border-[#27272a] rounded-2xl shadow-2xl p-8 space-y-6">
        
        <!-- Header -->
        <div class="flex items-center justify-between border-b border-[#27272a] pb-4">
            <div class="flex items-center space-x-3">
                <div class="w-10 h-10 rounded-xl bg-red-600/20 border border-red-500/40 flex items-center justify-center text-red-500 text-xl font-bold">
                    <i class="fa-solid fa-server"></i>
                </div>
                <div>
                    <h1 class="text-xl font-bold text-white">{{ app_title }}</h1>
                    <p class="text-xs text-zinc-400">Despliegue y Gestión de Configuración Automatizada</p>
                </div>
            </div>
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                Servidor Activo
            </span>
        </div>

        <!-- Mensaje Principal -->
        <div class="bg-gradient-to-r from-red-950/30 to-zinc-900 border border-red-900/40 rounded-xl p-5">
            <h2 class="text-base font-semibold text-red-400 flex items-center gap-2 mb-1">
                <i class="fa-solid fa-check-circle"></i> Aprovisionamiento Idempotente Exitoso
            </h2>
            <p class="text-xs text-zinc-300 leading-relaxed">
                Este servidor web Nginx ha sido instalado y configurado de forma declarativa mediante un <strong>Playbook de Ansible</strong>, sin intervención manual y garantizando repetibilidad.
            </p>
        </div>

        <!-- Datos Dinámicos Obtenidos por Ansible Facts -->
        <div class="space-y-3">
            <h3 class="text-xs uppercase tracking-wider text-zinc-400 font-semibold">Parámetros del Sistema (Ansible Facts)</h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
                
                <div class="bg-[#27272a]/40 border border-[#3f3f46]/30 p-3.5 rounded-lg">
                    <span class="text-zinc-400 block mb-0.5">Nodo / Hostname</span>
                    <span class="font-bold text-white code-font">{{ ansible_hostname }}</span>
                </div>

                <div class="bg-[#27272a]/40 border border-[#3f3f46]/30 p-3.5 rounded-lg">
                    <span class="text-zinc-400 block mb-0.5">Sistema Operativo</span>
                    <span class="font-bold text-white code-font">{{ ansible_distribution }} {{ ansible_distribution_version }}</span>
                </div>

                <div class="bg-[#27272a]/40 border border-[#3f3f46]/30 p-3.5 rounded-lg">
                    <span class="text-zinc-400 block mb-0.5">Arquitectura / Kernel</span>
                    <span class="font-bold text-white code-font">{{ ansible_architecture }} ({{ ansible_kernel }})</span>
                </div>

                <div class="bg-[#27272a]/40 border border-[#3f3f46]/30 p-3.5 rounded-lg">
                    <span class="text-zinc-400 block mb-0.5">Versión de Despliegue</span>
                    <span class="font-bold text-white code-font">v{{ app_version | default('1.0.0') }} (IaC Gestionado)</span>
                </div>

            </div>
        </div>

        <!-- Pilares de Gestión de Configuración -->
        <div class="border-t border-[#27272a] pt-4 grid grid-cols-3 gap-2 text-center text-xs">
            <div class="p-2.5 rounded-lg bg-zinc-900 border border-zinc-800">
                <i class="fa-solid fa-code text-red-500 mb-1 block"></i>
                <span class="font-semibold text-zinc-200 block">Declarativo</span>
                <span class="text-[10px] text-zinc-400">Estado deseado</span>
            </div>
            <div class="p-2.5 rounded-lg bg-zinc-900 border border-zinc-800">
                <i class="fa-solid fa-rotate-right text-red-500 mb-1 block"></i>
                <span class="font-semibold text-zinc-200 block">Idempotente</span>
                <span class="text-[10px] text-zinc-400">Sin cambios redundantes</span>
            </div>
            <div class="p-2.5 rounded-lg bg-zinc-900 border border-zinc-800">
                <i class="fa-solid fa-network-wired text-red-500 mb-1 block"></i>
                <span class="font-semibold text-zinc-200 block">Agentless</span>
                <span class="text-[10px] text-zinc-400">Sin software cliente</span>
            </div>
        </div>

    </div>
</body>
</html>
